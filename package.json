{
  "name": "numidea-labs-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Numidea Labs landing page \u2014 static site + project-preview capture pipeline.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "shots": "node scripts/shots.mjs",
    "logos": "node scripts/client-logos.mjs",
    "check": "node scripts/check.mjs && node scripts/themes-check.mjs",
    "bump": "node scripts/bump.mjs",
    "sweep": "node scripts/sweep.mjs",
    "audit": "node scripts/audit.mjs",
    "scene": "node scripts/build-scene.mjs",
    "work:capture": "node scripts/work-capture.mjs",
    "stage": "node scripts/stage-site.mjs",
    "build": "node scripts/build-fr.mjs && node scripts/build-scene.mjs && node scripts/build-voices.mjs && node scripts/build-legal.mjs && node scripts/build-sitemap.mjs && node scripts/build-csp.mjs",
    "csp": "node scripts/build-csp.mjs",
    "og": "node scripts/og-capture.mjs && node scripts/build-og.mjs",
    "hub:art": "node scripts/build-hub-art.mjs",
    "validate": "node scripts/validate.mjs",
    "vbugs": "node scripts/vbugs.mjs",
    "verify": "node scripts/verify.mjs",
    "keys": "node scripts/keys.mjs",
    "links": "node scripts/links.mjs",
    "kb": "node scripts/build-kb.mjs",
    "metrics": "node scripts/metrics.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "html-validate": "^11.16.1",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
