# no trailing slash: a node_modules symlink (a worktree sharing the main
# checkout's install) is ignored as well as the folder
node_modules
.DS_Store
*.log

# scratch: device-audit harness + its screenshot output (promoted to scripts/ if it earns it)
_*.mjs
_shots*/

# python bytecode from scratch tooling
__pycache__/
*.pyc
.tmp/

# staged deploy output (scripts/stage-site.mjs) and the unpublished legal preview
_site/
legal-preview/

# mirror CLI state: `netlify link` writes .netlify/, `vercel pull` writes
# .vercel/ (project ids; listed in scripts/site.mjs NOT_DEPLOYED)
.netlify/
.vercel/

# the campaign kit is the owner's private material (strategy, budget, client
# permissions); it is never committed to this public repository. Tools that
# read it: scripts/build-creative.mjs (CAMPAIGN_DIR or ./campaign).
campaign/

# local Claude Code settings
.claude/settings.local.json

# graphify working output (the committed graph lives in knowledge-base/graphify/)
graphify-out/
